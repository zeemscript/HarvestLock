# Copy to .env and fill in. Never commit the real .env.

# Postgres
DATABASE_URL=postgres://postgres:harvestlock@localhost:5432/harvestlock

# Stellar
# The network passphrase is what actually selects the network. There is
# deliberately no STELLAR_NETWORK variable here: one used to sit in this
# file, but no code ever read it (checked with grep across src/, scripts/
# and test/), so setting it silently did nothing -- removed by the .env
# audit rather than left as a stale entry that looks like it matters.
# The passphrase must match the network STELLAR_RPC_URL points at; rpc.ts
# falls back to the testnet passphrase if unset.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# The escrow WASM's hash, so the API can deploy fresh commitment
# instances without re-uploading the contract every time. Get this
# from `stellar contract build`'s output, or from an existing
# deployment via `stellar contract info` — never hardcode a specific
# CONTRACT_ID here, since one contract instance is one commitment
# (PRD §4.8) and the API creates a new instance per commitment.
ESCROW_WASM_HASH=

# An account that pays the network fee for deploying new commitment
# contracts. Not a party to any commitment itself — separate from the
# buyer/cooperative/warehouse keys, which sign their own actions.
DEPLOYER_SECRET_KEY=

PORT=3000

# Exact browser origins allowed to call the API, comma-separated. Leave
# empty until the deployed frontend domains are known; local frontend
# development can use e.g. http://localhost:5173.
CORS_ORIGINS=

# Only "test" is special to this API: server.ts skips the global rate
# limiter under it so the test suites' rapid-fire requests against one
# shared app don't trip it. Vitest sets NODE_ENV=test itself, so `npm
# test` doesn't depend on a value here; any other value, or unset, keeps
# rate limiting on — normal local development doesn't need to set it.
NODE_ENV=development
