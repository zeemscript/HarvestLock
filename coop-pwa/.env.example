# Copy to .env and adjust if the API isn't running on the default port.
VITE_API_URL=http://localhost:3000

# VITE_BUILD_SHA isn't set here: vite.config.ts injects it at build time
# from VERCEL_GIT_COMMIT_SHA/GITHUB_SHA (or git), and its `define`
# overrides any value placed in this file. Leaving it unset is normal --
# it only drives the footer's build stamp, and the footer just omits that
# when no SHA is available.
