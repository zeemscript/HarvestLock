# Copy to .env and fill in. Never commit the real .env.
#
# Nothing here is required for `npm test` to *run* -- without E2E_LIVE it
# skips every spec with a pointer to README.md, which is what keeps this
# package safe to invoke in CI and on an unconfigured laptop.

# The explicit opt-in. 1 = run against the real local API + testnet.
E2E_LIVE=1

# Where the local API is listening. Defaults to http://localhost:3000.
# E2E_API_URL=http://localhost:3000

# Origins the three app dev servers bind to. The API's CORS_ORIGINS must
# include all three (comma-separated); global-setup.ts fails fast with
# that exact hint if it doesn't.
# E2E_BUYER_ORIGIN=http://localhost:5173
# E2E_COOP_ORIGIN=http://localhost:5174
# E2E_WAREHOUSE_ORIGIN=http://localhost:5175

# Stellar endpoints, if you need something other than testnet's defaults.
# E2E_HORIZON_URL=https://horizon-testnet.stellar.org
# E2E_FRIENDBOT_URL=https://friendbot.stellar.org

# Optional fixed throwaway testnet keys (S...). When omitted -- the
# normal case -- each test generates fresh keypairs and funds them via
# friendbot, so no key material needs to exist anywhere before the run.
# Set these only if friendbot is rate-limiting you; they're still
# throwaway testnet keys, never a real wallet.
# E2E_BUYER_SECRET=
# E2E_COOPERATIVE_SECRET=
# E2E_WAREHOUSE_SECRET=
